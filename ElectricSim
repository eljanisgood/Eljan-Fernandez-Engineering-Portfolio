class UI:
    def __init__(self, xpos: int, ypos: int, font: str = None, fontSize: int = None):
        if font is None:
            font = DEFAULT_FONT
        if fontSize is None:
            fontSize = DEFAULT_FONT_SIZE
        self.xpos = xpos
        self.ypos = ypos
        self.font = font
        self.fontSize = fontSize
        return

    def UIDisplay(self, text : str):
        font = pygame.font.SysFont(self.font, self.fontSize)
        text = font.render(text, True, WHITE)
        window.blit(text, (self.xpos, self.ypos))
        return 

class Grid:    

    def __init__(self, sideLength : int, xpos : int, ypos : int):
        self.xpos = xpos
        self.ypos = ypos
        self.position = (self.xpos, self.ypos)
        self.sideLength = sideLength
        self.size = (self.sideLength, self.sideLength)
    
    def display(self): 
        return pygame.draw.rect(window, (NAVY), (self.position, self.size))

    def hoverDisplay(self):
        return

